# Backend de OpenLeaf: copiar a .env y rellenar con valores reales.
# NUNCA subir el archivo .env al repositorio.

# Servidor
PORT=
FRONTEND_URL=

# Supabase (el código concatena KEY_PART1 + KEY_PART2 si no se da SERVICE_ROLE_KEY)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KEY_PART1=
SUPABASE_KEY_PART2=

# Autenticación JWT
JWT_SECRET=
JWT_EXPIRES_IN=

# Correo: prioridad Brevo -> Resend -> SMTP
BREVO_API_KEY=
BREVO_FROM_NAME=
BREVO_FROM_EMAIL=
RESEND_API_KEY=
RESEND_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Catálogo de música (API de Jamendo)
JAMENDO_CLIENT_ID=

# Solo para el script create-admin
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Solo para el script smoke-test
API_URL=
