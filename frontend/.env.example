# Frontend de OpenLeaf: copiar a .env y rellenar.
# Solo variables VITE_: se exponen al navegador, NO poner secretos aquí.

# Base de la API. En local: /api (Vite hace proxy a http://localhost:3001)
# En producción: https://openleaf-backend.onrender.com/api
VITE_API_URL=

# Correo de contacto mostrado en el sitio
VITE_CONTACT_EMAIL=
